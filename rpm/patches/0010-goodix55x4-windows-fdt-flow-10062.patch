   g_clear_pointer (&priv->tls_ready_callback, g_free);
 }
+static void
+on_tls_handshake_settled (FpDevice *dev, gpointer user_data)
+{
+  on_tls_successfully_established (dev, NULL, NULL);
+}
+
 static void
 tls_handshake_done (FpiSsm *ssm, FpDevice *dev, GError *error)
 {
   if (error)
     fp_dbg ("failed to do tls handshake: %s (code: %d)", error->message,
             error->code);
-  goodix_send_tls_successfully_established (
-    dev, on_tls_successfully_established, NULL);
+  // Universal firmware 10062 drops the TLS session when it receives
+  // TLS_SUCCESSFULLY_ESTABLISHED (0xd4); the Windows driver never sends it.
+  // Give the MCU a moment to finish the handshake instead.
+  fpi_device_add_timeout (dev, 20, on_tls_handshake_settled, NULL, NULL);
 }
 
