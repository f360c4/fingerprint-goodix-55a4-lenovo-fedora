-static double
-frame_diff_score(Goodix55X4Pix frame[GOODIX55X4_FRAME_SIZE],
-                 Goodix55X4Pix background[GOODIX55X4_FRAME_SIZE]) {
-  guint64 sum = 0;
-  for (int i = 0; i != GOODIX55X4_FRAME_SIZE; ++i) {
