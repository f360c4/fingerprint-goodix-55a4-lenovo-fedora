+static void config_fix_checksum(guint8 *cfg) {
+  guint16 sum = 0xA5A5;
+  for (int i = 0; i < 254; i += 2)
+    sum += cfg[i] | (cfg[i + 1] << 8);
+  sum = 0x10000 - sum;
+  cfg[254] = sum & 0xFF;
+  cfg[255] = sum >> 8;
+}
+
+// Set a tag's 16-bit value inside the config section described by
+// cfg[sect_byte] (offset) and cfg[sect_byte + 1] (size); entries are
+// 4 bytes: tag (LE16), value (LE16). Mirrors Wbdi.dll 0x54db0.
+static gboolean config_set_tag(guint8 *cfg, int sect_byte, guint16 tag,
+                               guint16 value, gboolean keep_high) {
+  int base = cfg[sect_byte], size = cfg[sect_byte + 1];
+  for (int e = base; e + 3 < 256 && e < base + size; e += 4) {
+    if ((cfg[e] | (cfg[e + 1] << 8)) == tag) {
+      if (keep_high)
+        value = ((cfg[e + 2] | (cfg[e + 3] << 8)) & 0xFF00) | value;
+      cfg[e + 2] = value & 0xFF;
+      cfg[e + 3] = value >> 8;
+      return TRUE;
+    }
+  }
+  return FALSE;
+}
+
+// OTP decoding from Wbdi.dll _MilanFSerGetTcodeAndDiffFromOtp (0x64530)
+// and _MilanFSerGetFdtOffsetFromOtp (0x64370).
+static void on_read_otp(FpDevice *dev, guint8 *data, guint16 len,
+                        gpointer user_data, GError *error) {
+  FpiDeviceGoodixTls55X4 *self = FPI_DEVICE_GOODIXTLS55X4(dev);
+  guint16 tcode = GOODIX55X4_DEFAULT_TCODE, delta = GOODIX55X4_DEFAULT_DELTA;
+  guint8 offset = 0;
+
+  if (error) {
+    fpi_ssm_mark_failed(user_data, error);
+    return;
+  }
+
+  memcpy(self->config, goodix_55x4_config, sizeof(self->config));
+  if (len >= 0x20 && data[0x16] != 0 && data[0x16] + data[0x17] == 0xFF) {
+    guint8 v = data[0x16];
+    tcode = ((v >> 4) + 1) << 4;
+    delta = ((((v & 0xF) + 2) * 100) << 8) / tcode / 3 >> 4;
+  } else {
+    fp_warn("OTP calibration missing, using default tcode/delta");
+  }
+  if (len >= 0x20) {
+    guint8 b = data[0x11];
+    guint8 f0 = b & 3, f2 = (~b >> 2) & 3, f4 = (b >> 4) & 3;
+    if (f0 == f4 || f0 == f2)
+      offset = f0;
+    else if (f4 == f2)
+      offset = f4;
+  }
+  self->fdt_delta = delta;
+  // GOODIX55X4_TCODE (experiment): image sensing time code for the image
+  // section only; finger-detect thresholds keep the OTP-derived delta.
+  guint16 default_tcode =
+      MAX(0x30, tcode * GOODIX55X4_IMAGE_TCODE_NUM / GOODIX55X4_IMAGE_TCODE_DEN / 0x10 * 0x10);
+  guint16 image_tcode = (guint16)env_double("GOODIX55X4_TCODE", default_tcode);
+  if (image_tcode < 0x10 || image_tcode > 0x100)
+    image_tcode = default_tcode;
+  self->image_tcode = image_tcode;
+  config_set_tag(self->config, 9, 0x5C, image_tcode, FALSE);
+  // GOODIX55X4_FDT_DELTA (experiment): smaller = finger-down fires earlier in
+  // the landing, before sweat/pressure fill the ridge valleys.
+  guint16 trigger_delta = (guint16)env_double("GOODIX55X4_FDT_DELTA", delta);
+  if (trigger_delta < 4 || trigger_delta > 0x7f)
+    trigger_delta = delta;
+  config_set_tag(self->config, 5, 0x82, (trigger_delta << 8) | 0x80, FALSE);
+  if (offset > 0)
+    config_set_tag(self->config, 5, 0x56, offset + 8, TRUE);
+  config_fix_checksum(self->config);
+  g_print("OTP calibration: tcode 0x%x (image 0x%x), fdt delta 0x%x (trigger 0x%x), "
+          "fdt offset %u\n", tcode, image_tcode, delta, trigger_delta, offset);
+  fpi_ssm_next_state(user_data);
+}
