+static int reflect101(int i, int n) {
+  while (i < 0 || i >= n)
+    i = i < 0 ? -i : 2 * n - 2 - i;
+  return i;
+}
+
+// Separable Gaussian matching OpenCV's GaussianBlur for float images
+// (kernel size round(8 * sigma + 1) | 1, BORDER_REFLECT_101).
+static void gauss_blur(const float *in, float *out, int w, int h, double sigma) {
+  int ksize = ((int)lround(sigma * 8 + 1)) | 1, r = ksize / 2;
+  double *k = g_new(double, ksize), sum = 0;
+  for (int i = 0; i < ksize; i++) {
+    double x = i - r;
+    k[i] = exp(-x * x / (2 * sigma * sigma));
+    sum += k[i];
   }
-  return (double)sum / GOODIX55X4_FRAME_SIZE;
+  for (int i = 0; i < ksize; i++)
+    k[i] /= sum;
+  float *tmp = g_new(float, w * h);
+  for (int y = 0; y < h; y++)
+    for (int x = 0; x < w; x++) {
+      double acc = 0;
+      for (int i = 0; i < ksize; i++)
+        acc += k[i] * in[y * w + reflect101(x + i - r, w)];
+      tmp[y * w + x] = acc;
+    }
+  for (int y = 0; y < h; y++)
+    for (int x = 0; x < w; x++) {
+      double acc = 0;
+      for (int i = 0; i < ksize; i++)
+        acc += k[i] * tmp[reflect101(y + i - r, h) * w + x];
+      out[y * w + x] = acc;
+    }
+  g_free(tmp);
+  g_free(k);
+}
+
+static int cmp_float(const void *a, const void *b) {
+  float fa = *(const float *)a, fb = *(const float *)b;
+  return (fa > fb) - (fa < fb);
 }
 
-typedef struct _frame_processing_info {
-  FpiDeviceGoodixTls55X4 *dev;
-  GSList **frames;
+static float percentile(const float *v, int n, double pct) {
+  float *c = g_memdup2(v, n * sizeof(float));
+  qsort(c, n, sizeof(float), cmp_float);
+  double pos = pct / 100.0 * (n - 1);
+  int lo = (int)pos;
+  float res = lo + 1 < n ? c[lo] + (c[lo + 1] - c[lo]) * (pos - lo) : c[lo];
+  g_free(c);
+  return res;
+}
+
+// Turn a raw 12-bit capture into the 8-bit image given to the matcher.
+// Tuned offline on labelled raw captures (index vs middle/thumb):
+//  1. signed background difference (contact lowers the reading);
+//  2. remove the sensor's per-row stripe pattern;
+//  3. local contrast normalisation (sigma 4) so ridges fill the 8-bit range;
+//  4. non-contact areas set to neutral grey so finger outlines, which look
+//     alike between fingers, don't produce matches.
+static void normalize_frame(Goodix55X4Pix *frame, Goodix55X4Pix *background,
+                            guint8 *out) {
+  const int w = GOODIX55X4_WIDTH, h = GOODIX55X4_HEIGHT, n = w * h;
+  float *d = g_new(float, n), *f = g_new(float, n), *b = g_new(float, n);
+  float *hp = g_new(float, n), *sd = g_new(float, n);
+
+  for (int i = 0; i < n; i++)
+    d[i] = f[i] = (float)background[i] - (float)frame[i];
+
+  gauss_blur(f, b, w, h, 3);
+  for (int y = 0; y < h; y++) {
+    double row = 0;
+    for (int x = 0; x < w; x++)
+      row += f[y * w + x] - b[y * w + x];
+    row /= w;
+    for (int x = 0; x < w; x++)
+      f[y * w + x] -= row;
+  }
+
+  gauss_blur(f, b, w, h, 4);
+  for (int i = 0; i < n; i++) {
+    hp[i] = f[i] - b[i];
+    f[i] = hp[i] * hp[i];
+  }
+  gauss_blur(f, sd, w, h, 4);
+  for (int i = 0; i < n; i++)
+    sd[i] = sqrt(sd[i]);
+  float eps = percentile(sd, n, 50) * 0.3f;
+
+  gauss_blur(d, b, w, h, 6);
+  float contact = percentile(b, n, 95) * 0.5f;
+
+  for (int y = 0; y < h; y++)
+    for (int x = 0; x < w; x++) {
+      int i = y * w + x;
+      gboolean touched = TRUE;
+      // 5x5 erosion of the contact mask (out-of-image pixels don't erode)
+      for (int dy = -2; dy <= 2 && touched; dy++)
+        for (int dx = -2; dx <= 2; dx++) {
+          int yy = y + dy, xx = x + dx;
+          if (yy >= 0 && yy < h && xx >= 0 && xx < w && !(b[yy * w + xx] > contact)) {
+            touched = FALSE;
+            break;
+          }
+        }
+      double v = touched ? hp[i] / (sd[i] + eps) * 50 + 128 : 128;
+      out[i] = CLAMP(lround(v), 0, 255);
+    }
 
-} frame_processing_info;
+  g_free(d);
+  g_free(f);
+  g_free(b);
+  g_free(hp);
+  g_free(sd);
+}
 
