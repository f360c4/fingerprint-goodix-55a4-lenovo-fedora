+static void box_blur(const double *in, double *out, int w, int h, int r) {
+  double *integral = g_new0(double, (w + 1) * (h + 1));
+  for (int y = 0; y < h; y++) {
+    double row = 0;
+    for (int x = 0; x < w; x++) {
+      row += in[y * w + x];
+      integral[(y + 1) * (w + 1) + x + 1] = integral[y * (w + 1) + x + 1] + row;
+    }
+  }
+  for (int y = 0; y < h; y++) {
+    int y0 = MAX(y - r, 0), y1 = MIN(y + r + 1, h);
+    for (int x = 0; x < w; x++) {
+      int x0 = MAX(x - r, 0), x1 = MIN(x + r + 1, w);
+      double sum = integral[y1 * (w + 1) + x1] - integral[y0 * (w + 1) + x1] -
+                   integral[y1 * (w + 1) + x0] + integral[y0 * (w + 1) + x0];
+      out[y * w + x] = sum / ((y1 - y0) * (x1 - x0));
+    }
+  }
+  g_free(integral);
+}
 
