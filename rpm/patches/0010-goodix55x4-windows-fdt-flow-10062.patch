+// Capture flow reverse-engineered from Lenovo's Windows driver (Wbdi.dll,
+// LogicMilanFSeries.c / MilanFSer*.c / FpMcuCmd.c) for 27c6:55a4:
+//  - the config is patched with this sensor's OTP calibration (tcode, FDT
+//    delta, FDT offset) before upload;
+//  - FDT (finger detect) thresholds are computed from live per-area readings
+//    ("manual" FDT), so the MCU's finger-down event fires on a real touch;
+//  - the image is read immediately on the finger-down event: ridges on this
+//    sensor are only visible during the first moments of contact;
+//  - finger-up thresholds come from the values in the finger-down event.
+#define GOODIX55X4_FDT_AREAS 12
+#define GOODIX55X4_FDT_LEN (GOODIX55X4_FDT_AREAS * 2)
+#define GOODIX55X4_DEFAULT_TCODE 0x80
+#define GOODIX55X4_DEFAULT_DELTA 0x15
+// Image sensing time code. The OTP-calibrated value (0xf0 on the tested unit)
+// overdrives the pixel amplifier when a moist fingertip couples strongly: the
+// ridge valleys disappear (valley depth 0.04-0.09). 3/5 of it (0x90) kept them
+// on the same finger minutes later: valley depth 0.10-0.13 at 0x90 vs 0.08 at
+// 0xf0; enrollment 41/41 presses accepted (median 0.23) and 9/10 verifies
+// matched, where 0xf0 had given 0/10. The signal amplitude scales with it.
+#define GOODIX55X4_IMAGE_TCODE_NUM 3
+#define GOODIX55X4_IMAGE_TCODE_DEN 5
+#define GOODIX55X4_GATE_TCODE 0x90 // ridge gates below are for this tcode
+// Ridge score (see frame_ridge_score), scaled by image tcode / 0x90: the first
+// frame after the finger-down event is the clearest; ridges fade within ~100 ms
+// of contact. Below the gates the user is asked to touch again (libfprint retry,
+// shown by fprintd clients) instead of retrying silently.
+#define GOODIX55X4_MIN_RIDGE_ENROLL 16.0
+#define GOODIX55X4_MIN_RIDGE_VERIFY 14.0
+// Ridge-flow coherence gates (see frame_coherence); the enroll gate keeps
+// blotchy captures out of the template.
+// Logged for diagnosis; gates disabled by default (clear and blotchy captures
+// overlap: 0.60-0.79 vs 0.38-0.70 in labelled data).
+#define GOODIX55X4_MIN_COHERENCE_ENROLL 0.0
+#define GOODIX55X4_MIN_COHERENCE_VERIFY 0.0
+// Valley depth gates (see frame_valley_depth). Labelled data: clear captures
+// 0.105-0.25, sweat/pressure-filled captures 0.02-0.11 that matched neither
+// the template nor each other. The enroll gate keeps them out of the template.
+// At image tcode 0x90 clear captures are 0.19-0.31. A print enrolled from
+// presses at 0.10-0.15 (median 0.18) never matched (best 183 in ~30 tries),
+// one from presses at median 0.23 did; hence the stricter enroll gate.
+#define GOODIX55X4_MIN_VALLEY_ENROLL 0.18
+#define GOODIX55X4_MIN_VALLEY_VERIFY 0.10 // the one 0.09 verify capture failed to match
+// Tuning without rebuilding: fprintd service environment variables
+// GOODIX55X4_ENROLL_GATE, GOODIX55X4_VERIFY_GATE, GOODIX55X4_MATCH_THRESHOLD.
+static double env_double(const char *name, double fallback) {
+  const char *v = g_getenv(name);
+  if (!v || !*v)
+    return fallback;
+  gchar *end = NULL;
+  double d = g_ascii_strtod(v, &end);
+  return (end && *end == '\0' && d >= 0 && d < 100000) ? d : fallback;
+}
+// Let a lifted finger clear the sensor before re-reading the FDT base.
+#define GOODIX55X4_SETTLE_MS 250
+// FDT base (sum of the 12 area readings): finger-free ~4200-4450 on this
+// sensor, ~2650-2850 with a finger resting on it, 3000-3700 while lifting.
+// After a lift it recovers within ~0.5 s from a short touch but takes seconds
+// after a long press, and captures armed on a low base were poor.
+//  - finger on the sensor: never arm (the finger would become "empty sensor");
+//    wait for the lift, silently for verify (users lift and touch again after
+//    a failed match), asking to lift only if it stays there;
+//  - after a lift: wait (bounded, ~1.6 s) for a higher, steady base.
+// The reference is kept per process and never follows the base down to a
+// finger or lifting level (pkgrel 23 did, which broke finger detection after
+// repeated quick touches).
+#define GOODIX55X4_BASE_TYPICAL 4300
+#define GOODIX55X4_BASE_MIN_PERCENT 94
+#define GOODIX55X4_BASE_FINGER_PERCENT 80
+#define GOODIX55X4_BASE_DRIFT_PERCENT 90 // of BASE_TYPICAL: lowest accepted reference
+#define GOODIX55X4_BASE_RISE_PERCENT 102
+#define GOODIX55X4_BASE_WAIT_READS 6
+#define GOODIX55X4_ENROLL_LIFT_READS 4 // ~1.1 s before "remove finger" in enroll
+#define GOODIX55X4_VERIFY_LIFT_READS 55 // ~15 s before "remove finger" in verify
+#define GOODIX55X4_LIFT_WAIT_READS 20
+// Debug aid: if this directory exists, every capture is saved there.
+#define GOODIX55X4_DEBUG_DIR "/var/lib/fprint/debug"
 
